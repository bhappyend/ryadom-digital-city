{
	email {$ACME_EMAIL}
	admin off
	servers {
		timeouts {
			read_header 5s
			read_body 10s
			write 30s
			idle 60s
		}
	}
}

http://:8080 {
	bind 127.0.0.1
	respond /healthz "ok" 200
}

{$SITE_HOST} {
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		X-Frame-Options DENY
	}
	# Access logs intentionally disabled: raw addresses, coordinates and IPs must not be retained by default.
	# The sole larger-body exception: exact raw raster PUT ticket transport.
	@raster {
		method PUT
		path_regexp raster (?i)^/api/v1/admin/media/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/content/?$
	}
	handle @raster {
		request_body {
			max_size 2097152
		}
		header Cache-Control "no-store"
		reverse_proxy api:3001
	}
	@media path /media /media/*
	handle @media {
		request_body {
			max_size 16KB
		}
		header Cache-Control "no-store"
		reverse_proxy api:3001
	}
	@api path /api /api/*
	handle @api {
		request_body {
			max_size 16KB
		}
		header Cache-Control "no-store"
		reverse_proxy api:3001 {
			transport http {
				dial_timeout 3s
				response_header_timeout 10s
			}
		}
	}
	handle {
		request_body {
			max_size 16KB
		}
		reverse_proxy web:3000 {
			transport http {
				dial_timeout 3s
				response_header_timeout 15s
			}
		}
	}
}
