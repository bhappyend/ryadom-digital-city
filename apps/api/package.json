    "@ryadom/db": "0.1.0",
    "@ryadom/gis": "0.1.0",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "redis": "6.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
