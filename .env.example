# Copy to ignored .env; do not put real secrets into tracked files.
NODE_ENV=development
WEB_PORT=3000
API_PORT=3001
API_HOST=127.0.0.1
# Account keys are API-only in ignored .env.accounts.local (generated locally).
# ACCOUNT_MFA_KEY=<32 random bytes, base64>
# ACCOUNT_MFA_KEY_ID=<key identifier>
# ACCOUNT_RATE_KEY=<random secret>
# Local auth HTTP test only: NODE_ENV=development + ACCOUNT_ALLOW_LOOPBACK_HTTP=true.
# Production cookies remain Secure; do not enable this flag for production.
# Next server-only rewrite target. Browser always calls /api/v1 on its own origin.
API_URL=http://localhost:3001
PUBLIC_SITE_URL=http://localhost:3000
# Fixed deployment-controlled HTTPS origin for /media URLs; never derive from Host.
# Unset means catalog photos are omitted until configured. Production requires HTTPS.
PUBLIC_MEDIA_ORIGIN=
# HTTP only for explicit development loopback tests, never production:
# PUBLIC_MEDIA_ORIGIN=http://127.0.0.1:3000
# PUBLIC_MEDIA_ALLOW_LOOPBACK_HTTP=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Root runtime wrapper takes ONLY APP_DATABASE_URL and REDIS_URL from ignored
# infra/.env.local for the API. Do not copy admin credentials into web env.
# Optional explicit overrides (real values belong outside source control):
# APP_DATABASE_URL=postgresql://ryadom_app:replace-local-password@localhost:5432/ryadom
# REDIS_URL=redis://:replace-local-password@localhost:6379
# Migration/import CLI only; never use this privileged URL for the public API:
# DATABASE_URL=postgresql://ryadom_admin:replace-local-password@localhost:5432/ryadom
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-local-1
S3_BUCKET=ryadom
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Disabled until an approved instance, dataset, attribution and coverage are verified.
GEOCODER_PROVIDER=disabled
NOMINATIM_URL=
PELIAS_URL=
VALHALLA_URL=
GIS_ALLOWED_ORIGINS=
GIS_ALLOW_HTTP=false
GIS_USER_AGENT=
GIS_TIMEOUT_MS=5000
# Licensed map style URL served by configured map service, no private key here.
MAP_STYLE_URL=
MAP_ATTRIBUTION=
MAP_ALLOWED_ORIGINS=
MAP_ALLOW_HTTP=false
YANDEX_ADAPTER_ENABLED=false
DGIS_ADAPTER_ENABLED=false
