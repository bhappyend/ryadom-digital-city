{
  "name": "@ryadom/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/tokens.css",
    "./fonts.css": "./src/fonts.css",
    "./tokens.json": "./tokens.json"
  },
  "sideEffects": ["**/*.css"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:assets": "python scripts/audit-assets.py",
    "check:icons": "python scripts/generate-icons.py --check",
    "test": "node scripts/check-components.mjs"
  },
  "peerDependencies": { "react": "^19.0.0" },
  "devDependencies": { "@types/react": "19.3.3", "react-dom": "19.3.1" }
}
